# =============================================================================
# rm-sync environment configuration
# Copy to .env and fill in real values. `.env` is gitignored.
# Run `make setup` to bootstrap this file with a generated JWT secret.
# =============================================================================

# --- Network / NAS ---
# IP of NAS hosting the NFS export for rmfakecloud data
# (/Docker/rm-sync/rmfakecloud-data).
NAS_IP=192.168.0.134

# --- Domain ---
# Public hostname for rmfakecloud. Must resolve to the public IP, with ports
# 80 and 443 forwarded (via the nginx front proxy on the MediaWiki host) to
# this host on the same ports.
RMFAKECLOUD_DOMAIN=remarkable.brothersbrothers.net

# --- Let's Encrypt ---
# Email for expiry notices and ToS. Required.
ACME_EMAIL=

# ACME directory URL. Use staging while validating a new deployment to avoid
# burning production rate limits (5 duplicate certs per week). Switch to
# production once a staging cert issues successfully (`make use-prod`).
#
# Production:  https://acme-v02.api.letsencrypt.org/directory
# Staging:     https://acme-staging-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- rmfakecloud ---
# 32+ char random secret used to sign rmfakecloud's JWTs.
# `make setup` generates one automatically. Do not change this after users
# have been created — existing sessions will be invalidated.
JWT_SECRET_KEY=
