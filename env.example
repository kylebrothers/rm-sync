# =============================================================================
# rm-sync environment configuration
# Copy to .env and fill in real values. `.env` is gitignored.
# Run `make setup` to bootstrap this file with a generated JWT secret.
# =============================================================================

# --- Network / NAS ---
# IP of NAS hosting the NFS exports under /Docker/rm-sync/
NAS_IP=192.168.0.134

# --- Domain ---
# Public hostname for rmfakecloud. Must resolve to the public IP, with port 80
# and 443 forwarded (via the nginx front proxy on the MediaWiki host) to this
# host on the same ports.
RMFAKECLOUD_DOMAIN=remarkable.brothersbrothers.net

# --- Let's Encrypt ---
# Email for expiry notices and ToS.
ACME_EMAIL=

# Use STAGING while validating setup (browsers will warn; rate limits are generous).
# Switch to production via `make switch-prod` once a staging cert issues successfully.
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- rmfakecloud ---
# 32+ char random secret. `make setup` generates one automatically.
JWT_SECRET_KEY=
